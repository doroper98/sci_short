  "segments": [
    {
      "scene": "hero",
      "text": "누가 깎지도 않았는데, 수정은 어떻게 이런 모양이 될까요?",
      "gap": 0.7,
      "index": 0,
      "start": 1.2,
      "end": 4.656190476190476
    },
    {
      "scene": "hero",
      "text": "투명한 수정은 석영의 한 종류예요. 성분은 이산화규소죠.",
      "gap": 0.9,
      "spoken_chunks": [
        "투명한 수정은 석영의 한 종류예요.",
        "성분은 이산화 규소죠."
      ],
      "index": 1,
      "start": 5.356190476190476,
      "end": 9.646326530612246
    },
    {
      "scene": "origin",
      "text": "결정의 비밀은 겉모양보다 훨씬 작은, 원자 배열에 있어요.",
      "gap": 0.7,
      "index": 2,
      "start": 10.546326530612244,
      "end": 14.167233560090702
    },
    {
      "scene": "origin",
      "text": "석영은 마그마에서도, 뜨거운 물에서도 자랄 수 있어요.",
      "gap": 1.1,
      "index": 3,
      "start": 14.867233560090703,
      "end": 18.03063492063492
    },
    {
      "scene": "fluid",
      "text": "여기서는 암석 틈을 흐르는 뜨거운 물을 따라가 볼까요?",
      "gap": 0.7,
      "index": 4,
      "start": 19.13063492063492,
      "end": 22.23687074829932
    },
    {
      "scene": "fluid",
      "text": "물속에는 암석에서 녹아 나온 규소 화합물이 들어 있어요.",
      "gap": 1,
      "index": 5,
      "start": 22.93687074829932,
      "end": 26.19453514739229
    },
    {
      "scene": "species",
      "text": "중성에 가까운 물에서는, 규소가 규산 같은 분자 형태로 녹아 있어요.",
      "gap": 1.4,
      "index": 6,
      "start": 27.19453514739229,
      "end": 31.563333333333333
    },
    {
      "scene": "seed",
      "text": "물이 식어 녹여 둘 수 있는 양보다 성분이 많아지면, 결정이 생길 수 있어요.",
      "gap": 1.2,
      "index": 7,
      "start": 32.96333333333333,
      "end": 37.456054421768705
    },
    {
      "scene": "seed",
      "text": "작은 무리는 쉽게 흩어져도, 석영의 안정된 결정핵이 생기면 성장이 시작돼요.",
      "gap": 2,
      "index": 8,
      "start": 38.65605442176871,
      "end": 43.707845804988665
    },
    {
      "scene": "reaction",
      "text": "표면의 수산기, 즉 산소와 수소가 붙은 자리에서 결합이 바뀌는 과정을 볼게요.",
      "gap": 0.8,
      "index": 9,
      "start": 45.707845804988665,
      "end": 50.726462585034014
    },
    {
      "scene": "reaction",
      "text": "물 분자 하나가 빠져나가면서, 규소와 규소를 잇는 산소 다리가 만들어져요.",
      "gap": 2,
      "index": 10,
      "start": 51.52646258503402,
      "end": 56.058299319727894
    },
    {
      "scene": "tetra",
      "text": "석영 안에서는 규소 하나를 산소 네 개가 둘러싸요.",
      "gap": 2.3,
      "index": 11,
      "start": 58.058299319727894,
      "end": 61.04396825396826
    },
    {
      "scene": "network",
      "text": "산소 하나를 두 규소가 공유하므로, 사면체들이 삼차원으로 이어져요.",
      "gap": 1,
      "index": 12,
      "start": 63.34396825396826,
      "end": 67.46154195011339
    },
    {
      "scene": "network",
      "text": "원자들은 아무 자리에나 쌓이지 않고, 석영의 규칙적인 배열을 이어 가요.",
      "gap": 1.3,
      "index": 13,
      "start": 68.46154195011339,
      "end": 72.88181405895692
    },
    {
      "scene": "network",
      "text": "결합만 있다고 결정은 아니에요. 이 배열이 멀리까지 규칙적으로 반복돼야 하죠.",
      "gap": 1.3,
      "index": 14,
      "start": 74.18181405895692,
      "end": 79.13666666666667
    },
    {
      "scene": "grow",
      "text": "이 연결이 표면의 계단이나 꺾인 자리에서 반복되며, 결정이 자라요.",
      "gap": 1.6,
      "index": 15,
      "start": 80.43666666666667,
      "end": 84.6143537414966
    },
    {
      "scene": "facets",
      "text": "표면마다 자라는 속도가 달라, 평평한 면과 특징적인 각도가 나타나요.",
      "gap": 1,
      "index": 16,
      "start": 86.2143537414966,
      "end": 90.61877551020407
    },
    {
      "scene": "facets",
      "text": "충분한 공간이 있으면, 육각기둥과 뾰족한 끝이 잘 드러날 수 있죠.",
      "gap": 2,
      "index": 17,
      "start": 91.61877551020407,
      "end": 95.75356009070293
    },
    {
      "scene": "compare",
      "text": "하지만 서로 부딪히며 자라면, 겉모양은 불규칙해져요.",
      "gap": 0.8,
      "index": 18,
      "start": 97.75356009070293,
      "end": 100.89297052154194
    },
    {
      "scene": "compare",
      "text": "겉이 울퉁불퉁해도, 안의 원자 배열은 결정일 수 있어요.",
      "gap": 1.5,
      "index": 19,
      "start": 101.69297052154194,
      "end": 105.138820861678
    },
    {
      "scene": "end",
      "text": "수정의 모양을 만드는 건 조각가가 아니라, 원자들이 결합하는 규칙이에요.",
      "gap": 2,
